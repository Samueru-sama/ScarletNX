/* LINUX_LEVEL(guest, NAME): the guest's option levels as SNX_SOL_##NAME.
   LINUX_SOCKOPT(LEVEL, guest, NAME, layout): the guest's options (Linux's asm-generic values) as the stack's
   SNX_##NAME. layout is how the guest lays the value out when it differs from the stack's:
     SAME   as the stack's (ints, linger {int, int}, AArch64's timeval {s64, s64}, ipv6_mreq)
     MREQN  ip_mreq, or ip_mreqn {multiaddr, address, ifindex} whose first 8 bytes are an ip_mreq
     IFADDR in_addr, or an ip_mreq(n) whose address is at offset 4
   An option missing here fails with ENOPROTOOPT, as on a kernel without it */
#ifndef LINUX_LEVEL
#define LINUX_LEVEL(guest, name)
#endif
#ifndef LINUX_SOCKOPT
#define LINUX_SOCKOPT(level, guest, name, layout)
#endif
LINUX_LEVEL(0, IP)
LINUX_LEVEL(1, SOCKET)
LINUX_LEVEL(6, TCP)
LINUX_LEVEL(17, UDP)
LINUX_LEVEL(41, IPV6)

LINUX_SOCKOPT(SOCKET, 1, SO_DEBUG, SAME)
LINUX_SOCKOPT(SOCKET, 2, SO_REUSEADDR, SAME)
LINUX_SOCKOPT(SOCKET, 3, SO_TYPE, SAME)
LINUX_SOCKOPT(SOCKET, 4, SO_ERROR, SAME)
LINUX_SOCKOPT(SOCKET, 5, SO_DONTROUTE, SAME)
LINUX_SOCKOPT(SOCKET, 6, SO_BROADCAST, SAME)
LINUX_SOCKOPT(SOCKET, 7, SO_SNDBUF, SAME)
LINUX_SOCKOPT(SOCKET, 8, SO_RCVBUF, SAME)
LINUX_SOCKOPT(SOCKET, 9, SO_KEEPALIVE, SAME)
LINUX_SOCKOPT(SOCKET, 10, SO_OOBINLINE, SAME)
LINUX_SOCKOPT(SOCKET, 13, SO_LINGER, SAME)
LINUX_SOCKOPT(SOCKET, 15, SO_REUSEPORT, SAME)
LINUX_SOCKOPT(SOCKET, 18, SO_RCVLOWAT, SAME)
LINUX_SOCKOPT(SOCKET, 19, SO_SNDLOWAT, SAME)
LINUX_SOCKOPT(SOCKET, 20, SO_RCVTIMEO, SAME) /* SO_RCVTIMEO_OLD: 64-bit time_t already on AArch64 */
LINUX_SOCKOPT(SOCKET, 21, SO_SNDTIMEO, SAME)
LINUX_SOCKOPT(SOCKET, 30, SO_ACCEPTCONN, SAME)
LINUX_SOCKOPT(SOCKET, 38, SO_PROTOCOL, SAME)
LINUX_SOCKOPT(SOCKET, 39, SO_DOMAIN, SAME)
LINUX_SOCKOPT(SOCKET, 66, SO_RCVTIMEO, SAME) /* SO_RCVTIMEO_NEW, the same layout */
LINUX_SOCKOPT(SOCKET, 67, SO_SNDTIMEO, SAME)

LINUX_SOCKOPT(IP, 1, IP_TOS, SAME)
LINUX_SOCKOPT(IP, 2, IP_TTL, SAME)
LINUX_SOCKOPT(IP, 3, IP_HDRINCL, SAME)
LINUX_SOCKOPT(IP, 32, IP_MULTICAST_IF, IFADDR)
LINUX_SOCKOPT(IP, 33, IP_MULTICAST_TTL, SAME)
LINUX_SOCKOPT(IP, 34, IP_MULTICAST_LOOP, SAME)
LINUX_SOCKOPT(IP, 35, IP_ADD_MEMBERSHIP, MREQN)
LINUX_SOCKOPT(IP, 36, IP_DROP_MEMBERSHIP, MREQN)

LINUX_SOCKOPT(TCP, 1, TCP_NODELAY, SAME)
LINUX_SOCKOPT(TCP, 2, TCP_MAXSEG, SAME)
LINUX_SOCKOPT(TCP, 4, TCP_KEEPIDLE, SAME)
LINUX_SOCKOPT(TCP, 5, TCP_KEEPINTVL, SAME)
LINUX_SOCKOPT(TCP, 6, TCP_KEEPCNT, SAME)

LINUX_SOCKOPT(IPV6, 16, IPV6_UNICAST_HOPS, SAME)
LINUX_SOCKOPT(IPV6, 17, IPV6_MULTICAST_IF, SAME)
LINUX_SOCKOPT(IPV6, 18, IPV6_MULTICAST_HOPS, SAME)
LINUX_SOCKOPT(IPV6, 19, IPV6_MULTICAST_LOOP, SAME)
LINUX_SOCKOPT(IPV6, 20, IPV6_JOIN_GROUP, SAME)
LINUX_SOCKOPT(IPV6, 21, IPV6_LEAVE_GROUP, SAME)
LINUX_SOCKOPT(IPV6, 26, IPV6_V6ONLY, SAME)
#undef LINUX_LEVEL
#undef LINUX_SOCKOPT
