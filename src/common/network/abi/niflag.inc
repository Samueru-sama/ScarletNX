/* SNX_NET_NIFLAG(NAME, value, host): getnameinfo's flags (SNX_NI_##NAME), FreeBSD's values */
SNX_NET_NIFLAG(NOFQDN, 0x1, NI_NOFQDN)
SNX_NET_NIFLAG(NUMERICHOST, 0x2, NI_NUMERICHOST)
SNX_NET_NIFLAG(NAMEREQD, 0x4, NI_NAMEREQD)
SNX_NET_NIFLAG(NUMERICSERV, 0x8, NI_NUMERICSERV)
SNX_NET_NIFLAG(DGRAM, 0x10, NI_DGRAM)
#undef SNX_NET_NIFLAG
