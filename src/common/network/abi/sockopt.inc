/* SNX_NET_SOCKOPT(LEVEL, NAME, value, kind): socket options (SNX_##NAME), at level SNX_SOL_##LEVEL. The values are
   Linux's. On the host NAME is the host's own constant: net.c defines the ones a host lacks as SNX_NET_NOOPT, and
   setting them fails with SNX_ENOPROTOOPT.
   kind says how the value is laid out and who handles it:
     INT       an int (at least 4 bytes), passed to the host
     LINGER    SnxLinger
     ADDR4     4 bytes of IPv4 address, passed as they are
     MREQ      SnxIpMreq                  MREQ6  SnxIpv6Mreq
     RCVTIMEO  SNDTIMEO  SnxTimeval, kept by the stack: host sockets never block, the stack waits for them
     TYPE  PROTOCOL  DOMAIN  read only, what the socket was opened with
     ERROR     the pending error, translated
     NOOP      accepted and ignored (SO_NOSIGPIPE: the stack never raises SIGPIPE) */
SNX_NET_SOCKOPT(SOCKET, SO_DEBUG, 1, INT)
SNX_NET_SOCKOPT(SOCKET, SO_REUSEADDR, 2, INT)
SNX_NET_SOCKOPT(SOCKET, SO_TYPE, 3, TYPE)
SNX_NET_SOCKOPT(SOCKET, SO_ERROR, 4, ERROR)
SNX_NET_SOCKOPT(SOCKET, SO_DONTROUTE, 5, INT)
SNX_NET_SOCKOPT(SOCKET, SO_BROADCAST, 6, INT)
SNX_NET_SOCKOPT(SOCKET, SO_SNDBUF, 7, INT)
SNX_NET_SOCKOPT(SOCKET, SO_RCVBUF, 8, INT)
SNX_NET_SOCKOPT(SOCKET, SO_KEEPALIVE, 9, INT)
SNX_NET_SOCKOPT(SOCKET, SO_OOBINLINE, 10, INT)
SNX_NET_SOCKOPT(SOCKET, SO_LINGER, 13, LINGER)
SNX_NET_SOCKOPT(SOCKET, SO_REUSEPORT, 15, INT)
SNX_NET_SOCKOPT(SOCKET, SO_RCVLOWAT, 18, INT)
SNX_NET_SOCKOPT(SOCKET, SO_SNDLOWAT, 19, INT)
SNX_NET_SOCKOPT(SOCKET, SO_RCVTIMEO, 20, RCVTIMEO)
SNX_NET_SOCKOPT(SOCKET, SO_SNDTIMEO, 21, SNDTIMEO)
SNX_NET_SOCKOPT(SOCKET, SO_ACCEPTCONN, 30, INT)
SNX_NET_SOCKOPT(SOCKET, SO_PROTOCOL, 38, PROTOCOL)
SNX_NET_SOCKOPT(SOCKET, SO_DOMAIN, 39, DOMAIN)
SNX_NET_SOCKOPT(SOCKET, SO_NOSIGPIPE, 0x7F00, NOOP) /* not a Linux option: BSD's, which Horizon has */
SNX_NET_SOCKOPT(IP, IP_TOS, 1, INT)
SNX_NET_SOCKOPT(IP, IP_TTL, 2, INT)
SNX_NET_SOCKOPT(IP, IP_HDRINCL, 3, INT)
SNX_NET_SOCKOPT(IP, IP_MULTICAST_IF, 32, ADDR4)
SNX_NET_SOCKOPT(IP, IP_MULTICAST_TTL, 33, INT)
SNX_NET_SOCKOPT(IP, IP_MULTICAST_LOOP, 34, INT)
SNX_NET_SOCKOPT(IP, IP_ADD_MEMBERSHIP, 35, MREQ)
SNX_NET_SOCKOPT(IP, IP_DROP_MEMBERSHIP, 36, MREQ)
SNX_NET_SOCKOPT(IPV6, IPV6_UNICAST_HOPS, 16, INT)
SNX_NET_SOCKOPT(IPV6, IPV6_MULTICAST_IF, 17, INT)
SNX_NET_SOCKOPT(IPV6, IPV6_MULTICAST_HOPS, 18, INT)
SNX_NET_SOCKOPT(IPV6, IPV6_MULTICAST_LOOP, 19, INT)
SNX_NET_SOCKOPT(IPV6, IPV6_JOIN_GROUP, 20, MREQ6)
SNX_NET_SOCKOPT(IPV6, IPV6_LEAVE_GROUP, 21, MREQ6)
SNX_NET_SOCKOPT(IPV6, IPV6_V6ONLY, 26, INT)
SNX_NET_SOCKOPT(TCP, TCP_NODELAY, 1, INT)
SNX_NET_SOCKOPT(TCP, TCP_MAXSEG, 2, INT)
SNX_NET_SOCKOPT(TCP, TCP_KEEPIDLE, 4, INT)
SNX_NET_SOCKOPT(TCP, TCP_KEEPINTVL, 5, INT)
SNX_NET_SOCKOPT(TCP, TCP_KEEPCNT, 6, INT)
#undef SNX_NET_SOCKOPT
