/* GLSL port of gpu/texture/astc.c. One invocation decodes one 128-bit LDR block.
   The output is raw RGBA8 bytes, not linearized sRGB. A transfer copies these bytes
   into either an UNORM or an SRGB image. No storage-image format features needed. */
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Source {
    uvec4 blocks[];
} src;
layout(set = 0, binding = 1, std430) writeonly buffer Destination {
    uint pixels[];
} dst;
layout(push_constant) uniform Params {
    uint width, height, block_width, block_height, srgb;
} pc;

void store_pixel(int x, int y, uint rgba) {
    uvec2 p = gl_GlobalInvocationID.xy * uvec2(pc.block_width, pc.block_height) + uvec2(x, y);
    if (p.x < pc.width && p.y < pc.height) dst.pixels[p.y * pc.width + p.x] = rgba;
}

/* ---------------------------------------------------------------- bits */
uint getbits(uvec4 d, int pos, int n) {
    uint v = 0;
    for (int i = 0; i < n; i++) {
        int p = pos + i;
        v |= uint(((d[p >> 5] >> (p & 31)) & 1)) << i;
    }
    return v;
}
uint getbits_rev(uvec4 d, int pos, int n) { /* reads bits backwards from the block end */
    uint v = 0;
    for (int i = 0; i < n; i++) {
        int p = 127 - (pos + i);
        v |= uint(((d[p >> 5] >> (p & 31)) & 1)) << i;
    }
    return v;
}

/* ---------------------------------------------------------------- ISE (trits / quints) */
struct Q {
    int bits, trits, quints;
};
const Q qtab[21] = Q[21](Q(1, 0, 0), Q(0, 1, 0), Q(2, 0, 0), Q(0, 0, 1), Q(1, 1, 0), Q(3, 0, 0), Q(1, 0, 1), Q(2, 1, 0),
                         Q(4, 0, 0), Q(2, 0, 1), Q(3, 1, 0), Q(5, 0, 0), Q(3, 0, 1), Q(4, 1, 0), Q(6, 0, 0), Q(4, 0, 1),
                         Q(5, 1, 0), Q(7, 0, 0), Q(5, 0, 1), Q(6, 1, 0), Q(8, 0, 0));
int ise_bits(int count, int q) {
    Q t = qtab[q];
    return t.bits * count + ((t.trits != 0) ? (8 * count + 4) / 5 : 0) + ((t.quints != 0) ? (7 * count + 2) / 3 : 0);
}
void decode_trits(uint T, out int result[5]) {
    int C;
#define TB(i) (int(((T >> (i)) & 1)))
    if (((T >> 2) & 7) == 7) {
        C = int(((((T >> 5) & 7) << 2) | (T & 3)));
        result[4] = 2;
        result[3] = 2;
    } else {
        C = int((T & 0x1F));
        if (((T >> 5) & 3) == 3) {
            result[4] = 2;
            result[3] = TB(7);
        } else {
            result[4] = TB(7);
            result[3] = int(((T >> 5) & 3));
        }
    }
#undef TB
    int c0 = C & 1, c1 = (C >> 1) & 1, c2 = (C >> 2) & 1, c3 = (C >> 3) & 1, c4 = (C >> 4) & 1;
    if ((C & 3) == 3) {
        result[2] = 2;
        result[1] = c4;
        result[0] = (c3 << 1) | (c2 & ~c3 & 1);
    } else if (((C >> 2) & 3) == 3) {
        result[2] = 2;
        result[1] = 2;
        result[0] = C & 3;
    } else {
        result[2] = c4;
        result[1] = (C >> 2) & 3;
        result[0] = (c1 << 1) | (c0 & ~c1 & 1);
    }
}
void decode_quints(uint Qv, out int result[3]) {
    int q[3];
    if (((Qv >> 1) & 3) == 3 && ((Qv >> 5) & 3) == 0) {
        q[2] = int((((Qv & 1) << 2) | ((((Qv >> 4) & 1) & ~(Qv & 1)) << 1) | (((Qv >> 3) & 1) & ~(Qv & 1))));
        q[1] = 4;
        q[0] = 4;
    } else {
        int C;
        if (((Qv >> 1) & 3) == 3) {
            q[2] = 4;
            C = int(((((Qv >> 3) & 3) << 3) | ((~(Qv >> 5) & 3) << 1) | (Qv & 1)));
        } else {
            q[2] = int(((Qv >> 5) & 3));
            C = int((Qv & 0x1F));
        }
        if ((C & 7) == 5) {
            q[1] = 4;
            q[0] = (C >> 3) & 3;
        } else {
            q[1] = (C >> 3) & 3;
            q[0] = C & 7;
        }
    }
    for (int i = 0; i < 3; i++) result[i] = q[i];
}
/* decode 'count' ISE values into vals[] (low bits | trit/quint << bits) */
void ise_decode(uvec4 d, int pos, int count, int q, out int vals[64], bool rev) {
    Q t = qtab[q];
    int nb = t.bits;
#define GB(p, n) (rev ? getbits_rev(d, (p), (n)) : getbits(d, (p), (n)))
    if (t.trits != 0) {
        for (int blk = 0; blk < count; blk += 5) {
            uint m[5] = uint[5](0, 0, 0, 0, 0), T = 0;
            int n = count - blk < 5 ? count - blk : 5;
            const ivec2 tb[5] = ivec2[5](ivec2(0, 2), ivec2(2, 2), ivec2(4, 1), ivec2(5, 2), ivec2(7, 1));
            for (int i = 0; i < 5; i++) {
                if (i < n) {
                    m[i] = GB(pos, nb);
                    pos += nb;
                } else
                    m[i] = 0;
                uint tv = 0;
                if (i < n) {
                    tv = GB(pos, tb[i][1]);
                    pos += tb[i][1];
                }
                T |= tv << tb[i][0];
            }
            /* trit bits past count aren't stored, clamp pos */
            int tr[5];
            decode_trits(T, tr);
            for (int i = 0; i < n; i++) vals[blk + i] = int((m[i] | (uint(tr[i]) << nb)));
        }
    } else if (t.quints != 0) {
        for (int blk = 0; blk < count; blk += 3) {
            uint m[3] = uint[3](0, 0, 0), Qv = 0;
            int n = count - blk < 3 ? count - blk : 3;
            const ivec2 qb[3] = ivec2[3](ivec2(0, 3), ivec2(3, 2), ivec2(5, 2));
            for (int i = 0; i < 3; i++) {
                if (i < n) {
                    m[i] = GB(pos, nb);
                    pos += nb;
                    uint qv = GB(pos, qb[i][1]);
                    pos += qb[i][1];
                    Qv |= qv << qb[i][0];
                }
            }
            int qq[3];
            decode_quints(Qv, qq);
            for (int i = 0; i < n; i++) vals[blk + i] = int((m[i] | (uint(qq[i]) << nb)));
        }
    } else {
        for (int i = 0; i < count; i++) {
            vals[i] = int(GB(pos, nb));
            pos += nb;
        }
    }
#undef GB
}

/* ---------------------------------------------------------------- unquantize */
int unq_color(int v, int q) {
    Q t = qtab[q];
    int nb = t.bits;
    if ((t.trits == 0) && (t.quints == 0)) { /* bit-replicate to 8 bits */
        int x = v;
        int r = x << (8 - nb);
        int sh = 8 - nb;
        while (sh > 0) {
            sh -= nb;
            r |= sh >= 0 ? x << sh : x >> (-sh);
        }
        return r & 255;
    }
    int m = v & ((1 << nb) - 1), tq = v >> nb;
    int A = ((m & 1) != 0) ? 0x1FF : 0, B = 0, C = 0, D = tq;
    int b = (m >> 1) & 1, c = (m >> 2) & 1, dd = (m >> 3) & 1, e = (m >> 4) & 1, f = (m >> 5) & 1;
    if (t.trits != 0) {
        switch (nb) {
            case 1:
                C = 204;
                B = 0;
                break;
            case 2:
                C = 93;
                B = (b << 8) | (b << 4) | (b << 2) | (b << 1);
                break;
            case 3:
                C = 44;
                B = (c << 8) | (b << 7) | (c << 3) | (b << 2) | (c << 1) | b;
                break;
            case 4:
                C = 22;
                B = (dd << 8) | (c << 7) | (b << 6) | (dd << 2) | (c << 1) | b;
                break;
            case 5:
                C = 11;
                B = (e << 8) | (dd << 7) | (c << 6) | (b << 5) | (e << 1) | dd;
                break;
            case 6:
                C = 5;
                B = (f << 8) | (e << 7) | (dd << 6) | (c << 5) | (b << 4) | f;
                break;
            default: C = 0; B = 0;
        }
    } else {
        switch (nb) {
            case 1:
                C = 113;
                B = 0;
                break;
            case 2:
                C = 54;
                B = (b << 8) | (b << 3) | (b << 2);
                break;
            case 3:
                C = 26;
                B = (c << 8) | (b << 7) | (c << 2) | (b << 1) | c;
                break;
            case 4:
                C = 13;
                B = (dd << 8) | (c << 7) | (b << 6) | (dd << 1) | c;
                break;
            case 5:
                C = 6;
                B = (e << 8) | (dd << 7) | (c << 6) | (b << 5) | e;
                break;
            default: C = 0; B = 0;
        }
    }
    int T2 = D * C + B;
    T2 ^= A;
    T2 = (A & 0x80) | (T2 >> 2);
    return T2 & 255;
}
int unq_weight(int v, int q) {
    Q t = qtab[q];
    int nb = t.bits;
    int r;
    if ((t.trits == 0) && (t.quints == 0)) {
        switch (nb) {
            case 1: r = (v != 0) ? 63 : 0; break;
            case 2: r = (v << 4) | (v << 2) | v; break;
            case 3: r = (v << 3) | v; break;
            case 4: r = (v << 2) | (v >> 2); break;
            case 5: r = (v << 1) | (v >> 4); break;
            default: r = v;
        }
    } else {
        int m = v & ((1 << nb) - 1), tq = v >> nb;
        int A = ((m & 1) != 0) ? 0x7F : 0, B = 0, C = 0, D = tq;
        int b = (m >> 1) & 1, c = (m >> 2) & 1;
        if (t.trits != 0) {
            switch (nb) {
                case 0: {
                    const int tab[3] = int[3](0, 32, 63);
                    r = tab[tq];
                    return r > 32 ? r + 1 : r;
                }
                case 1:
                    C = 50;
                    B = 0;
                    break;
                case 2:
                    C = 23;
                    B = (b << 6) | (b << 2) | b;
                    break;
                case 3:
                    C = 11;
                    B = (c << 6) | (b << 5) | (c << 1) | b;
                    break;
            }
        } else {
            switch (nb) {
                case 0: {
                    const int tab[5] = int[5](0, 16, 32, 47, 63);
                    r = tab[tq];
                    return r > 32 ? r + 1 : r;
                }
                case 1:
                    C = 28;
                    B = 0;
                    break;
                case 2:
                    C = 13;
                    B = (b << 6) | (b << 1);
                    break;
            }
        }
        int T2 = D * C + B;
        T2 ^= A;
        T2 = (A & 0x20) | (T2 >> 2);
        r = T2;
    }
    if (r > 32) r++;
    return r;
}

/* ---------------------------------------------------------------- endpoints */
void bit_transfer_signed(inout int a, inout int b) {
    b >>= 1;
    b |= a & 0x80;
    a >>= 1;
    a &= 0x3F;
    if ((a & 0x20) != 0) a -= 0x40;
}
int clamp255(int v) { return v < 0 ? 0 : v > 255 ? 255 : v; }
void blue_contract(inout int r, inout int g, int b) {
    r = (r + b) >> 1;
    g = (g + b) >> 1;
}
void decode_endpoints(int mode, int v[8], out int e0[4], out int e1[4]) {
    switch (mode) {
        case 0:
            e0[0] = e0[1] = e0[2] = v[0];
            e0[3] = 255;
            e1[0] = e1[1] = e1[2] = v[1];
            e1[3] = 255;
            break;
        case 1: {
            int L0 = (v[0] >> 2) | (v[1] & 0xC0), L1 = L0 + (v[1] & 0x3F);
            if (L1 > 255) L1 = 255;
            e0[0] = e0[1] = e0[2] = L0;
            e0[3] = 255;
            e1[0] = e1[1] = e1[2] = L1;
            e1[3] = 255;
            break;
        }
        case 4:
            e0[0] = e0[1] = e0[2] = v[0];
            e0[3] = v[2];
            e1[0] = e1[1] = e1[2] = v[1];
            e1[3] = v[3];
            break;
        case 5: {
            int v0 = v[0], v1 = v[1], v2 = v[2], v3 = v[3];
            bit_transfer_signed(v1, v0);
            bit_transfer_signed(v3, v2);
            e0[0] = e0[1] = e0[2] = v0;
            e0[3] = v2;
            e1[0] = e1[1] = e1[2] = clamp255(v0 + v1);
            e1[3] = clamp255(v2 + v3);
            break;
        }
        case 6:
            e0[0] = (v[0] * v[3]) >> 8;
            e0[1] = (v[1] * v[3]) >> 8;
            e0[2] = (v[2] * v[3]) >> 8;
            e0[3] = 255;
            e1[0] = v[0];
            e1[1] = v[1];
            e1[2] = v[2];
            e1[3] = 255;
            break;
        case 8: {
            int s0 = v[0] + v[2] + v[4], s1 = v[1] + v[3] + v[5];
            if (s1 >= s0) {
                e0[0] = v[0];
                e0[1] = v[2];
                e0[2] = v[4];
                e0[3] = 255;
                e1[0] = v[1];
                e1[1] = v[3];
                e1[2] = v[5];
                e1[3] = 255;
            } else {
                e0[0] = v[1];
                e0[1] = v[3];
                e0[2] = v[5];
                e0[3] = 255;
                e1[0] = v[0];
                e1[1] = v[2];
                e1[2] = v[4];
                e1[3] = 255;
                blue_contract(e0[0], e0[1], e0[2]);
                blue_contract(e1[0], e1[1], e1[2]);
            }
            break;
        }
        case 9: {
            int v0 = v[0], v1 = v[1], v2 = v[2], v3 = v[3], v4 = v[4], v5 = v[5];
            bit_transfer_signed(v1, v0);
            bit_transfer_signed(v3, v2);
            bit_transfer_signed(v5, v4);
            /* the sums stay unclamped through blue_contract and are clamped at the end, as for mode 13 */
            if (v1 + v3 + v5 >= 0) {
                e0[0] = v0;
                e0[1] = v2;
                e0[2] = v4;
                e0[3] = 255;
                e1[0] = v0 + v1;
                e1[1] = v2 + v3;
                e1[2] = v4 + v5;
                e1[3] = 255;
            } else {
                e0[0] = v0 + v1;
                e0[1] = v2 + v3;
                e0[2] = v4 + v5;
                e0[3] = 255;
                e1[0] = v0;
                e1[1] = v2;
                e1[2] = v4;
                e1[3] = 255;
                blue_contract(e0[0], e0[1], e0[2]);
                blue_contract(e1[0], e1[1], e1[2]);
            }
            for (int i = 0; i < 3; i++) {
                e0[i] = clamp255(e0[i]);
                e1[i] = clamp255(e1[i]);
            }
            break;
        }
        case 10:
            e0[0] = (v[0] * v[3]) >> 8;
            e0[1] = (v[1] * v[3]) >> 8;
            e0[2] = (v[2] * v[3]) >> 8;
            e0[3] = v[4];
            e1[0] = v[0];
            e1[1] = v[1];
            e1[2] = v[2];
            e1[3] = v[5];
            break;
        case 12: {
            int s0 = v[0] + v[2] + v[4], s1 = v[1] + v[3] + v[5];
            if (s1 >= s0) {
                e0[0] = v[0];
                e0[1] = v[2];
                e0[2] = v[4];
                e0[3] = v[6];
                e1[0] = v[1];
                e1[1] = v[3];
                e1[2] = v[5];
                e1[3] = v[7];
            } else {
                e0[0] = v[1];
                e0[1] = v[3];
                e0[2] = v[5];
                e0[3] = v[7];
                e1[0] = v[0];
                e1[1] = v[2];
                e1[2] = v[4];
                e1[3] = v[6];
                blue_contract(e0[0], e0[1], e0[2]);
                blue_contract(e1[0], e1[1], e1[2]);
            }
            break;
        }
        case 13: {
            int w[8];
            for (int i = 0; i < 8; i++) w[i] = v[i];
            bit_transfer_signed(w[1], w[0]);
            bit_transfer_signed(w[3], w[2]);
            bit_transfer_signed(w[5], w[4]);
            bit_transfer_signed(w[7], w[6]);
            if (w[1] + w[3] + w[5] >= 0) {
                e0[0] = w[0];
                e0[1] = w[2];
                e0[2] = w[4];
                e0[3] = w[6];
                e1[0] = w[0] + w[1];
                e1[1] = w[2] + w[3];
                e1[2] = w[4] + w[5];
                e1[3] = w[6] + w[7];
            } else {
                e0[0] = w[0] + w[1];
                e0[1] = w[2] + w[3];
                e0[2] = w[4] + w[5];
                e0[3] = w[6] + w[7];
                e1[0] = w[0];
                e1[1] = w[2];
                e1[2] = w[4];
                e1[3] = w[6];
                blue_contract(e0[0], e0[1], e0[2]);
                blue_contract(e1[0], e1[1], e1[2]);
            }
            for (int i = 0; i < 4; i++) {
                e0[i] = clamp255(e0[i]);
                e1[i] = clamp255(e1[i]);
            }
            break;
        }
        default: /* HDR modes -> magenta, LDR only */
            e0[0] = 255;
            e0[1] = 0;
            e0[2] = 255;
            e0[3] = 255;
            for (int i = 0; i < 4; i++) e1[i] = e0[i];
            break;
    }
}

/* ---------------------------------------------------------------- partitions */
uint hash52(uint p) {
    p ^= p >> 15;
    p -= p << 17;
    p += p << 7;
    p += p << 4;
    p ^= p >> 5;
    p += p << 16;
    p ^= p >> 7;
    p ^= p >> 3;
    p ^= p << 6;
    p ^= p >> 17;
    return p;
}
int select_partition(int seed, int x, int y, int z, int count, bool small) {
    if (small) {
        x <<= 1;
        y <<= 1;
        z <<= 1;
    }
    seed += (count - 1) * 1024;
    uint rnum = hash52(uint(seed));
    uint s1 = rnum & 0xF, s2 = (rnum >> 4) & 0xF, s3 = (rnum >> 8) & 0xF, s4 = (rnum >> 12) & 0xF,
         s5 = (rnum >> 16) & 0xF, s6 = (rnum >> 20) & 0xF, s7 = (rnum >> 24) & 0xF, s8 = (rnum >> 28) & 0xF;
    uint s9 = (rnum >> 18) & 0xF, s10 = (rnum >> 22) & 0xF, s11 = (rnum >> 26) & 0xF,
         s12 = ((rnum >> 30) | (rnum << 2)) & 0xF;
    s1 *= s1;
    s2 *= s2;
    s3 *= s3;
    s4 *= s4;
    s5 *= s5;
    s6 *= s6;
    s7 *= s7;
    s8 *= s8;
    s9 *= s9;
    s10 *= s10;
    s11 *= s11;
    s12 *= s12;
    int sh1, sh2, sh3;
    if ((seed & 1) != 0) {
        sh1 = ((seed & 2) != 0) ? 4 : 5;
        sh2 = (count == 3) ? 6 : 5;
    } else {
        sh1 = (count == 3) ? 6 : 5;
        sh2 = ((seed & 2) != 0) ? 4 : 5;
    }
    sh3 = ((seed & 0x10) != 0) ? sh1 : sh2;
    s1 >>= sh1;
    s2 >>= sh2;
    s3 >>= sh1;
    s4 >>= sh2;
    s5 >>= sh1;
    s6 >>= sh2;
    s7 >>= sh1;
    s8 >>= sh2;
    s9 >>= sh3;
    s10 >>= sh3;
    s11 >>= sh3;
    s12 >>= sh3;
    int a = int(s1 * uint(x) + s2 * uint(y) + s11 * uint(z) + (rnum >> 14)),
        b = int(s3 * uint(x) + s4 * uint(y) + s12 * uint(z) + (rnum >> 10)),
        c = int(s5 * uint(x) + s6 * uint(y) + s9 * uint(z) + (rnum >> 6)),
        d = int(s7 * uint(x) + s8 * uint(y) + s10 * uint(z) + (rnum >> 2));
    a &= 0x3F;
    b &= 0x3F;
    c &= 0x3F;
    d &= 0x3F;
    if (count < 4) d = 0;
    if (count < 3) c = 0;
    if (a >= b && a >= c && a >= d) return 0;
    if (b >= c && b >= d) return 1;
    if (c >= d) return 2;
    return 3;
}

/* ---------------------------------------------------------------- block */
void fill_block(int bw, int bh, uint rgba) {
    for (int y = 0; y < bh; y++)
        for (int x = 0; x < bw; x++) store_pixel(x, y, rgba);
}
int decode_block_mode(int bm, out int gw, out int gh, out int dual, out int wq) {
    int R, H = (bm >> 9) & 1, D = (bm >> 10) & 1, A, B;
    if (((bm & 3) == 0)) { /* low 2 bits == 0 */
        R = ((bm >> 4) & 1) | ((bm >> 1) & 6);
        A = (bm >> 5) & 3;
        B = (bm >> 9) & 3;
        switch ((bm >> 7) & 3) {
            case 0:
                gw = 12;
                gh = A + 2;
                break;
            case 1:
                gw = A + 2;
                gh = 12;
                break;
            case 2:
                A = (bm >> 5) & 3;
                B = (bm >> 9) & 3;
                gw = A + 6;
                gh = B + 6;
                D = 0;
                H = 0;
                break;
            case 3:
                switch ((bm >> 5) & 3) {
                    case 0:
                        gw = 6;
                        gh = 10;
                        break;
                    case 1:
                        gw = 10;
                        gh = 6;
                        break;
                    default: return 0;
                }
                break;
        }
    } else {
        R = ((bm >> 4) & 1) | ((bm & 3) << 1);
        A = (bm >> 5) & 3;
        B = (bm >> 7) & 3;
        switch ((bm >> 2) & 3) {
            case 0:
                gw = B + 4;
                gh = A + 2;
                break;
            case 1:
                gw = B + 8;
                gh = A + 2;
                break;
            case 2:
                gw = A + 2;
                gh = B + 8;
                break;
            case 3:
                if (((bm >> 8) & 1) != 0) {
                    gw = ((bm >> 7) & 1) + 2;
                    gh = A + 2;
                } else {
                    gw = A + 2;
                    gh = ((bm >> 7) & 1) + 6;
                }
                break;
        }
    }
    if (R < 2) return 0;
    /* R 2..7 -> weight ranges 2,3,4,5,6,8 (H=0) or 10,12,16,20,24,32 (H=1): qtab indices 0..11 */

    wq = R - 2 + H * 6;
    dual = D;
    return 1;
}
void decode_block(uvec4 blk, int bw, int bh, bool srgb) {
    int bm = int(getbits(blk, 0, 12)); /* void extent validation also needs reserved bit 11 */
    if ((bm & 0x1FF) == 0x1FC) { /* void extent = solid color */
        /* bit 9 makes it HDR (FP16 colours), which an LDR decoder can't give, and bits 10-11 are reserved as 1s:
           otherwise the block is an error */
        if ((((bm >> 9) & 1) != 0) || ((bm >> 10) & 3) != 3) {
            fill_block(bw, bh, 0xffff00ffu);
            return;
        }
        uint r = getbits(blk, 64, 16), g = getbits(blk, 80, 16), b = getbits(blk, 96, 16), a = getbits(blk, 112, 16);
        fill_block(bw, bh, (r >> 8) | ((g >> 8) << 8) | ((b >> 8) << 16) | ((a >> 8) << 24));
        return;
    }
    int gw, gh, dual, wq;
    if (decode_block_mode(bm, gw, gh, dual, wq) == 0 || gw > bw || gh > bh) {
        fill_block(bw, bh, 0xffff00ffu);
        return;
    }
    /* qtab: 0:2 1:3 2:4 3:5 4:6 5:8 6:10 7:12 8:16 9:20 10:24 11:32 12:40 ... (the weight range is its index) */
    int qw = wq;
    int nparts = int(getbits(blk, 11, 2)) + 1;
    int nweights = gw * gh * ((dual != 0) ? 2 : 1);
    int wbits = ise_bits(nweights, qw);
    if (nweights > 64 || wbits < 24 || wbits > 96 || (nparts == 4 && dual != 0)) {
        fill_block(bw, bh, 0xffff00ffu);
        return;
    }
    int cem[4];
    int pos;
    int part_seed = 0;
    int extra_cem_bits = 0;
    if (nparts == 1) {
        cem[0] = int(getbits(blk, 13, 4));
        pos = 17;
    } else {
        part_seed = int(getbits(blk, 13, 10));
        uint cemv = getbits(blk, 23, 6);
        if (((cemv & 3) == 0)) {
            int m = int((cemv >> 2));
            for (int i = 0; i < nparts; i++) cem[i] = m;
            pos = 29;
        } else {
            int base = int(((cemv & 3) - 1)) * 4;
            extra_cem_bits = 3 * nparts - 4;
            int wstart = 128 - wbits;
            uint extra = getbits(blk, wstart - extra_cem_bits, extra_cem_bits);
            uint cm = (cemv >> 2) | (extra << 4);
            int c[4], m[4];
            for (int i = 0; i < nparts; i++) {
                c[i] = int((cm & 1));
                cm >>= 1;
            }
            for (int i = 0; i < nparts; i++) {
                m[i] = int((cm & 3));
                cm >>= 2;
            }
            for (int i = 0; i < nparts; i++) cem[i] = base + c[i] * 4 + m[i];
            pos = 29;
        }
    }
    int nvals = 0;
    for (int i = 0; i < nparts; i++) nvals += ((cem[i] >> 2) + 1) * 2;
    if (nvals > 18) {
        fill_block(bw, bh, 0xffff00ffu);
        return;
    }
    int avail = 128 - wbits - pos - extra_cem_bits - ((dual != 0) ? 2 : 0);
    /* pick the highest color quant level that fits; colour endpoints have 6 levels at least (qtab 4), a block
       with less room is an error */
    int cq = -1;
    for (int q = 20; q >= 4; q--) {
        if (ise_bits(nvals, q) <= avail) {
            cq = q;
            break;
        }
    }
    if (cq < 0) {
        fill_block(bw, bh, 0xffff00ffu);
        return;
    }
    int cvals[64];
    ise_decode(blk, pos, nvals, cq, cvals, false);
    for (int i = 0; i < nvals; i++) cvals[i] = unq_color(cvals[i], cq);
    int plane2_comp = -1;
    if (dual != 0) plane2_comp = int(getbits(blk, 128 - wbits - extra_cem_bits - 2, 2));
    int ep[4][2][4];
    int vi = 0;
    for (int i = 0; i < nparts; i++) {
        int values[8];
        int count = ((cem[i] >> 2) + 1) * 2;
        for (int j = 0; j < 8; j++) values[j] = j < count ? cvals[vi + j] : 0;
        decode_endpoints(cem[i], values, ep[i][0], ep[i][1]);
        vi += ((cem[i] >> 2) + 1) * 2;
    }
    /* weights */
    int wv[64];
    ise_decode(blk, 0, nweights, qw, wv, true);
    for (int i = 0; i < nweights; i++) wv[i] = unq_weight(wv[i], qw);
    /* infill: weight grid -> texel grid */
    int Ds = (1024 + bw / 2) / (bw - 1), Dt = (1024 + bh / 2) / (bh - 1);
    for (int t = 0; t < bh; t++)
        for (int s = 0; s < bw; s++) {
            int cs = Ds * s, ct = Dt * t;
            int gs = (cs * (gw - 1) + 32) >> 6, gt = (ct * (gh - 1) + 32) >> 6;
            int js = gs >> 4, fs = gs & 15, jt = gt >> 4, ft = gt & 15;
            int w11 = (fs * ft + 8) >> 4, w10 = ft - w11, w01 = fs - w11, w00 = 16 - fs - ft + w11;
            int pw[2];
            for (int pl = 0; pl < ((dual != 0) ? 2 : 1); pl++) {
                int v0 = js + jt * gw;
                int p00 = wv[(v0) * ((dual != 0) ? 2 : 1) + pl];
                int p01 = js + 1 < gw ? wv[(v0 + 1) * ((dual != 0) ? 2 : 1) + pl] : 0;
                int p10 = jt + 1 < gh ? wv[(v0 + gw) * ((dual != 0) ? 2 : 1) + pl] : 0;
                int p11 = (js + 1 < gw && jt + 1 < gh) ? wv[(v0 + gw + 1) * ((dual != 0) ? 2 : 1) + pl] : 0;
                pw[pl] = (p00 * w00 + p01 * w01 + p10 * w10 + p11 * w11 + 8) >> 4;
            }
            int part = nparts > 1 ? select_partition(part_seed, s, t, 0, nparts, bw * bh < 31) : 0;
            uint rgba = 0;
            for (int c = 0; c < 4; c++) {
                int w = (dual != 0 && c == plane2_comp) ? pw[1] : pw[0];
                int e0 = ep[part][0][c], e1 = ep[part][1][c];
                /* endpoints to 16 bits: for an sRGB texture the low byte is 0x80 (the ASTC spec's decode mode) */
                int C0 = srgb ? (e0 << 8) | 0x80 : e0 * 257, C1 = srgb ? (e1 << 8) | 0x80 : e1 * 257;
                int C = (C0 * (64 - w) + C1 * w + 32) >> 6;
                rgba |= uint(C >> 8) << (8 * c);
            }
            store_pixel(s, t, rgba);
        }
}

void main() {
    uint bx = (pc.width + pc.block_width - 1) / pc.block_width;
    uint by = (pc.height + pc.block_height - 1) / pc.block_height;
    if (gl_GlobalInvocationID.x >= bx || gl_GlobalInvocationID.y >= by) return;
    uvec4 block_data = src.blocks[gl_GlobalInvocationID.y * bx + gl_GlobalInvocationID.x];
    decode_block(block_data, int(pc.block_width), int(pc.block_height), pc.srgb != 0);
}
