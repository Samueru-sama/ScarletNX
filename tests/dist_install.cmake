# `cmake --install --component desktop` puts each program's desktop entry and the icon in every size where desktops
# look, nothing else, each file the one in dist/. Run by ctest as dist_install (tests/CMakeLists.txt)
file(REMOVE_RECURSE "${PREFIX}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD}" --component desktop --prefix "${PREFIX}"
    RESULT_VARIABLE result OUTPUT_QUIET)
if(result)
    message(FATAL_ERROR "cmake --install --component desktop failed: ${result}")
endif()
set(want "${DATADIR}/icons/hicolor/scalable/apps/wimsy.svg")
set(from "wimsy.svg")
foreach(size 16 22 24 32 48 64 128 256)
    list(APPEND want "${DATADIR}/icons/hicolor/${size}x${size}/apps/wimsy.png")
    list(APPEND from "icons/hicolor/${size}x${size}/apps/wimsy.png")
endforeach()
if(NX)
    list(APPEND want "${DATADIR}/applications/scarletnx.desktop")
    list(APPEND from "scarletnx.desktop")
endif()
if(GUI)
    list(APPEND want "${DATADIR}/applications/scarletnx-gui.desktop")
    list(APPEND from "scarletnx-gui.desktop")
endif()
file(GLOB_RECURSE got RELATIVE "${PREFIX}" "${PREFIX}/*")
set(sorted_want ${want})
list(SORT got)
list(SORT sorted_want)
if(NOT got STREQUAL sorted_want)
    string(REPLACE ";" "\n  " got "${got}")
    string(REPLACE ";" "\n  " sorted_want "${sorted_want}")
    message(FATAL_ERROR "installed:\n  ${got}\nwanted:\n  ${sorted_want}")
endif()
foreach(path source IN ZIP_LISTS want from)
    file(SHA256 "${PREFIX}/${path}" installed)
    file(SHA256 "${DIST}/${source}" original)
    if(NOT installed STREQUAL original)
        message(FATAL_ERROR "${path} is not dist/${source}")
    endif()
endforeach()
list(LENGTH want count)
message(STATUS "desktop component: ${count} files where desktops look for them")
