# The recompiler's LLVM backend (--backend=llvm, the default) links LLVM's C API, a required dependency: llvm-config
# finds it, SNX_LLVM_CONFIG names one (llvm-config, llvm-config-19, llvm-config19 on FreeBSD...). A cross build (the
# windows-cross preset) builds the runtime without it: its recompiler can't build modules, the game's host does.
# Windows too, for now: llvm-mingw (scripts/bootstrap.ps1) has no LLVM libraries, and no LLVM for MinGW is staged yet,
# so a native Windows build without llvm-config gets a recompiler that only stages data (scarletnx -r says why).
set(SNX_LLVM_FOUND OFF)
if(TRUE)
    if(CMAKE_CROSSCOMPILING)
        # the runtime library is generated by a tool built for the build machine
        message(STATUS "LLVM backend: not built when cross-compiling")
    else()
        set(snx_llvm_names llvm-config)
        foreach(version RANGE 30 17 -1)
            list(APPEND snx_llvm_names llvm-config-${version} llvm-config${version})
        endforeach()
        find_program(SNX_LLVM_CONFIG NAMES ${snx_llvm_names} DOC "llvm-config of the LLVM the LLVM backend links")
        if(SNX_LLVM_CONFIG)
            execute_process(COMMAND "${SNX_LLVM_CONFIG}" --version OUTPUT_VARIABLE SNX_LLVM_VERSION
                OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE snx_llvm_rc)
            execute_process(COMMAND "${SNX_LLVM_CONFIG}" --includedir OUTPUT_VARIABLE SNX_LLVM_INCLUDE_DIR
                OUTPUT_STRIP_TRAILING_WHITESPACE)
            execute_process(COMMAND "${SNX_LLVM_CONFIG}" --libdir OUTPUT_VARIABLE SNX_LLVM_LIBRARY_DIR
                OUTPUT_STRIP_TRAILING_WHITESPACE)
            execute_process(COMMAND "${SNX_LLVM_CONFIG}" --libs core native passes target analysis
                OUTPUT_VARIABLE SNX_LLVM_LIBS OUTPUT_STRIP_TRAILING_WHITESPACE)
            execute_process(COMMAND "${SNX_LLVM_CONFIG}" --system-libs core native passes target analysis
                OUTPUT_VARIABLE SNX_LLVM_SYSTEM_LIBS OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(snx_llvm_rc EQUAL 0 AND EXISTS "${SNX_LLVM_INCLUDE_DIR}/llvm-c/Core.h")
                separate_arguments(SNX_LLVM_LIBS UNIX_COMMAND "${SNX_LLVM_LIBS}")
                separate_arguments(SNX_LLVM_SYSTEM_LIBS UNIX_COMMAND "${SNX_LLVM_SYSTEM_LIBS}")
                set(SNX_LLVM_FOUND ON)
                message(STATUS "LLVM backend: LLVM ${SNX_LLVM_VERSION} (${SNX_LLVM_CONFIG})")
            endif()
        endif()
        if(NOT SNX_LLVM_FOUND AND WIN32)
            message(WARNING "LLVM not found (no llvm-config): scarletnx -r can't build game modules on this Windows "
                            "build; point SNX_LLVM_CONFIG at an LLVM for MinGW to build them")
        elseif(NOT SNX_LLVM_FOUND)
            message(FATAL_ERROR "LLVM's development files are required (the recompiler's code generator): install them "
                                "or point SNX_LLVM_CONFIG at an llvm-config")
        endif()
    endif()
endif()
